# Copy to .env and adjust. None of these are required for the sample data.

# Where the SQLite database lives.
NORDIC_CLOSE_DB=data/nordic_close.db

# Folder with the input CSV files and the close plan.
NORDIC_CLOSE_DATA=data/sample

# Currency the group reports in: SEK, NOK, DKK or EUR.
NORDIC_CLOSE_PRESENTATION_CURRENCY=SEK

# If set, every API route except /api/health needs this value in the X-API-Key header.
# Leave empty for local use.
NORDIC_CLOSE_API_KEY=

# Materiality policy for the flux review. Both thresholds must be exceeded.
NORDIC_CLOSE_FLUX_PCT=10
NORDIC_CLOSE_FLUX_ABS=1000000

# Intercompany tolerance in EUR. Differences at or below this are treated as rounding.
NORDIC_CLOSE_IC_TOLERANCE_EUR=1.00

# Days an open reconciling item may stay open before it counts as stale.
NORDIC_CLOSE_STALE_DAYS=90

# Target working day for sign-off in the close plan check.
NORDIC_CLOSE_TARGET_WD=5
